# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Render Service Configuration
PORT=3000

# Google Apps Script Webhook Endpoint (HTTPS URL to deployed Google Apps Script web app)
APPS_SCRIPT_URL=

# Webhook Shared Secret for HMAC Authorization (Server-Only, Minimum 32 characters, Cryptographically Random)
WEBHOOK_SECRET=

# Session Signing Secret (Server-Only, Mandatory, Minimum 32 characters, Cryptographically Random)
SESSION_SECRET=

# Initial Evaluation Account Passwords (Server-Only, Mandatory in Production, Minimum 12 characters)
INITIAL_REV_MH_PWD=
INITIAL_LEADERSHIP_PWD=
INITIAL_ADMIN_PWD=

# Meta WhatsApp Cloud API Webhook Integration (Server-Only, Receive-Only Test Sink)
# WHATSAPP_WEBHOOK_ENABLED: 'true' to enable the webhook endpoint; defaults to 'false' (fail-closed)
WHATSAPP_WEBHOOK_ENABLED=false
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Shared secret string matching the verify token entered in the Meta App Dashboard
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET: Meta App Secret from Meta App Dashboard -> Basic Settings (used for X-Hub-Signature-256 HMAC)
META_APP_SECRET=
