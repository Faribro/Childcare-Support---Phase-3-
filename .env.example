# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Render Service Configuration
PORT=3000

# Google Apps Script Webhook Endpoint (HTTPS URL to deployed Google Apps Script web app)
APPS_SCRIPT_URL=

# Webhook Shared Secret for HMAC Authorization (Server-Only, Minimum 32 characters, Cryptographically Random)
WEBHOOK_SECRET=

# Session Signing Secret (Server-Only, Mandatory, Minimum 32 characters, Cryptographically Random)
SESSION_SECRET=

# Initial Evaluation Account Passwords (Server-Only, Mandatory in Production, Minimum 12 characters)
INITIAL_REV_MH_PWD=
INITIAL_LEADERSHIP_PWD=
INITIAL_ADMIN_PWD=

# Meta WhatsApp Cloud API Webhook Integration (Server-Only, Receive-Only Test Sink)
# WHATSAPP_WEBHOOK_ENABLED: 'true' to enable the webhook endpoint; defaults to 'false' (fail-closed)
WHATSAPP_WEBHOOK_ENABLED=false
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Shared secret string matching the verify token entered in the Meta App Dashboard
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET: Meta App Secret from Meta App Dashboard -> Basic Settings (used for X-Hub-Signature-256 HMAC)
META_APP_SECRET=

# Leadership Individual Email Authentication & Allowlist (PR B)
# Server-only flag: must be explicitly 'true' to enable leadership email authentication endpoints.
LEADERSHIP_EMAIL_AUTH_ENABLED=false
# Optional client flag for UI display links:
NEXT_PUBLIC_LEADERSHIP_EMAIL_AUTH_ENABLED=false
# Optional cutover mode ('email_only' disables legacy shared-password logins for Leadership):
LEADERSHIP_EMAIL_AUTH_MODE=

# Supabase Server-Only Database Credentials (Required in production/staging for distributed persistent auth store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Leadership Allowlist JSON (Server-Only bootstrap, Never commit real emails to Git)
# Format: JSON array of authorized leader objects
# LEADERSHIP_ALLOWLIST_JSON='[{"id":"00000000-0000-0000-0000-000000000001","email":"leader1@example.org","name":"Leader Name","title":"Director","role":"LEADERSHIP","allowedStates":["*"],"allowedDistricts":["*"],"isActive":true,"authVersion":1}]'
LEADERSHIP_ALLOWLIST_JSON=

# Email Dispatch Provider Options (Server-Only; in production, fails closed if unconfigured)
# Sender address for all transactional emails:
EMAIL_FROM="Alliance India Childcare" <auth@allianceindia.org>
# Option 1: SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Option 2: Resend API Configuration
RESEND_API_KEY=
# Option 3: Google Apps Script Dispatch Gateway (Server-Only, Preview/Staging)
EMAIL_PROVIDER=
APPS_SCRIPT_WEBAPP_URL=
APPS_SCRIPT_DISPATCH_SECRET=
