# ==============================================================================
# Childcare Support Phase 3 — Environment Variable Template
# ==============================================================================
# Format: Names only. Never commit real credentials, passwords, or tokens to git.
# Sensitive values must be provisioned via Google Cloud Secret Manager.
# Plain configuration is set via Cloud Run container environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED (Mandatory for Cloud Run service startup & data access)
# ------------------------------------------------------------------------------
# Application Environment & Runtime Target
APP_ENV=
NODE_ENV=
GOOGLE_CLOUD_PROJECT=

# Data & Storage Selection
DATA_ENGINE=
STORAGE_PROVIDER=
FIRESTORE_DATABASE_ID=
GCS_BUCKET_NAME=
GCS_SIGNING_SERVICE_ACCOUNT=

# Core Application Cryptographic Secrets (Provisioned in Secret Manager)
SESSION_SECRET=
WEBHOOK_SECRET=
ARGON2_PEPPER=
LEADERSHIP_AUTH_SECRET=
UNIFIED_COOKIE_SIGNING_KEY=

# Central Google Sheets Upstream Bridge
APPS_SCRIPT_URL=

# ------------------------------------------------------------------------------
# 2. OPTIONAL (Configurable feature flags, tuning, auth providers, and scheduled jobs)
# ------------------------------------------------------------------------------
# Server Network Binding
PORT=
HOSTNAME=

# Canonical Base URLs & Allowed Hostnames (Firebase Hosting & Domain Rewrites)
APP_BASE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_ENV=
ALLOWED_HOSTS=
STAGING_SERVICE_URL=
PRODUCTION_URL=

# Cookie Management Strategy ('default' for separate cookies, 'unified' for single __session behind Firebase Hosting)
COOKIE_STRATEGY=
USE_UNIFIED_SESSION_COOKIE=

# Cloud Scheduler Authorization & Internal Diagnostics
CRON_SECRET=
DIAGNOSTICS_SECRET=
INTERNAL_AUTH_SECRET=

# Leadership & Field Coordinator Authentication
LEADERSHIP_EMAIL_AUTH_ENABLED=
NEXT_PUBLIC_LEADERSHIP_EMAIL_AUTH_ENABLED=
LEADERSHIP_EMAIL_AUTH_MODE=
LEADERSHIP_SINGLE_ACTIVE_SESSION=
LEADERSHIP_ALLOWLIST_JSON=
EXPORT_DELIVERY_JOB_RETENTION_DAYS=

# Google OAuth 2.0 (Field User Onboarding)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email Dispatch Configuration
EMAIL_PROVIDER=
EMAIL_FROM=
APPS_SCRIPT_WEBAPP_URL=
APPS_SCRIPT_DISPATCH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESEND_API_KEY=

# Inbound Webhook Testing Sink (WhatsApp / Meta Cloud API)
WHATSAPP_WEBHOOK_ENABLED=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Client Build-Time Passthrough Values
NEXT_PUBLIC_DATA_ENGINE=
NEXT_PUBLIC_STORAGE_PROVIDER=
NEXT_PUBLIC_GCS_BUCKET=
GIT_COMMIT_SHA=

# ------------------------------------------------------------------------------
# 3. STAGING-ONLY (Specific settings for staging Cloud Run instance csc-staging)
# ------------------------------------------------------------------------------
# Guard: strictly prevent live email delivery to real beneficiaries during testing
ALLOW_LIVE_EMAIL_DISPATCH=false

# ------------------------------------------------------------------------------
# 4. PRODUCTION-ONLY (Specific settings for production Cloud Run instance csc-prod)
# ------------------------------------------------------------------------------
# Authorize live email delivery to verified leadership & field coordinators
ALLOW_LIVE_EMAIL_DISPATCH=true

# ------------------------------------------------------------------------------
# 5. ROLLBACK-ONLY (Legacy Supabase, Tigris & Vercel fallback settings)
# ------------------------------------------------------------------------------
# Retained for emergency rollback to frozen commit 520f1a4 on Vercel
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
TIGRIS_BUCKET=
NEXT_PUBLIC_TIGRIS_BUCKET=
NEXT_PUBLIC_VERCEL_PROTECTION_BYPASS=
