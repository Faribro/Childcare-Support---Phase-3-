# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Render Service Configuration
PORT=3000

# Google Apps Script Webhook Endpoint
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Webhook Shared Secret for HMAC Authorization
WEBHOOK_SECRET=your_32_character_cryptographic_secret_here

# Session Secret for Encrypted Authentication Cookies
SESSION_SECRET=your_32_character_session_secret_here
