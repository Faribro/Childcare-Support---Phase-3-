# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Render Service Configuration
PORT=3000

# Google Apps Script Webhook Endpoint (HTTPS URL to deployed Google Apps Script web app)
APPS_SCRIPT_URL=

# Webhook Shared Secret for HMAC Authorization (Server-Only, Minimum 32 characters, Cryptographically Random)
WEBHOOK_SECRET=

# Session Signing Secret (Server-Only, Mandatory, Minimum 32 characters, Cryptographically Random)
SESSION_SECRET=

# Initial Evaluation Account Passwords (Server-Only, Mandatory in Production, Minimum 12 characters)
INITIAL_REV_MH_PWD=
INITIAL_LEADERSHIP_PWD=
INITIAL_ADMIN_PWD=

# Leadership Individual Email Authentication & Allowlist (PR B)
LEADERSHIP_EMAIL_AUTH_ENABLED=false
NEXT_PUBLIC_LEADERSHIP_EMAIL_AUTH_ENABLED=false

# Leadership Allowlist JSON (Server-Only, Never commit real emails to Git)
# Format: JSON array of authorized leader objects
# LEADERSHIP_ALLOWLIST_JSON='[{"id":"lead-01","email":"leader1@example.org","name":"Leader Name","title":"Director","role":"LEADERSHIP","allowedStates":["*"],"allowedDistricts":["*"],"isActive":true,"authVersion":1}]'
LEADERSHIP_ALLOWLIST_JSON=

# Email Dispatch Provider Options (SMTP or Resend; falls back to mock logger if unset)
EMAIL_FROM="Alliance India Childcare" <auth@allianceindia.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
